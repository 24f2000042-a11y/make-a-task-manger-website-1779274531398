# .env file

# Port for the server to run on
PORT=5000

# MongoDB connection string
# Example: MONGO_URI=mongodb://localhost:27017/taskmanagerdb
# For Atlas: MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/taskmanagerdb
